# ---- Twilio (console.twilio.com) ----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# A voice-capable Twilio number you own, E.164 format
TWILIO_FROM_NUMBER=+15550001111

# ---- You ----
# The ONLY number this server will ever call or text (E.164)
USER_PHONE_NUMBER=+15552223333
# How the assistant greets you: "Hi <USER_NAME>, this is ..."
USER_NAME=there

# ---- Server ----
# Public HTTPS URL where this server is reachable (Render/Railway/Fly URL, or an ngrok tunnel)
PUBLIC_BASE_URL=https://your-app.example.com
PORT=3000
# http = remote MCP at /mcp (for Meta Muse, Claude Duet, claude.ai connectors)
# stdio = local MCP (Claude Desktop / Claude Code); webhooks still served on PORT
MCP_TRANSPORT=http
# Required for http mode. Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# ---- Call behaviour (optional) ----
TIMEZONE=America/New_York
# Only urgency="critical" calls ring during this window (local to TIMEZONE)
QUIET_HOURS=22:00-07:00
MAX_CALLS_PER_HOUR=6
TWILIO_VOICE=Polly.Joanna-Neural
CALL_LANGUAGE=en-US
# Detect voicemail, leave the message and text it to you instead
ANSWERING_MACHINE_DETECTION=true
# Seconds of silence before the server re-prompts "are you still there?"
SPEECH_TIMEOUT_SECONDS=8
# Hang up politely if the agent goes quiet for this long
MAX_HOLD_SECONDS=120
MAX_CALL_SECONDS=900
# Only disable for local debugging
TWILIO_VALIDATE_SIGNATURE=true
