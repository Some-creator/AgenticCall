{
  "name": "agentic-call",
  "version": "0.1.0",
  "description": "MCP server that lets AI agents phone you via Twilio and hold a two-way voice conversation about important tasks and notifications.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agentic-call": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test-call": "node scripts/test-call.mjs"
  },
  "engines": {
    "node": ">=18.18"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^18.0.10",
    "express": "^5.2.1",
    "groq-sdk": "^1.6.0",
    "twilio": "^6.3.0",
    "ws": "^8.22.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
